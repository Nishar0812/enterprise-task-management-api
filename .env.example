# Flask environment: development | testing | production
FLASK_ENV=development

# Cryptographic secret used for session signing. Generate a strong random value.
SECRET_KEY=change-me

# Secret used to sign JWTs. Generate a strong random value, distinct from SECRET_KEY.
JWT_SECRET_KEY=change-me

# SQLAlchemy database URI.
# Local development default (SQLite): sqlite:///dev.db
# Production example (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///dev.db
